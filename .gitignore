# dependencies
node_modules/
.pnp
.pnp.js

# builds
.next/
out/
dist/
build/

# secrets — NEVER commit these.
# server/.env holds JWT_SECRET, the operator password and the Firebase service
# account; web/.env* holds build-time config. Only the .env.example files,
# which contain placeholders, are tracked.
.env
.env.*
!.env.example
# web/.env.production holds only PUBLIC build values — the Firebase web config
# ships in every browser bundle anyway, and the WS URL is a public address.
# Tracking it keeps a hosting rebuild reproducible from a clean clone.
!web/.env.production
*serviceAccount*.json
*service-account*.json
*-firebase-adminsdk-*.json

# firebase
.firebase/
firebase-debug.log

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo
next-env.d.ts
# one-off patch scripts must never be committed
*.py
