# ── quiz-show web ───────────────────────────────────────────────────────────
# Copy to .env.local for local dev. On Railway set these as service variables.
# They are inlined at BUILD time, so redeploy after changing them.

# The realtime server (Railway URL in production, https — the socket upgrades to wss).
NEXT_PUBLIC_WS_URL=http://localhost:8080

# Optional: only if you set DISPLAY_KEY on the server.
# NEXT_PUBLIC_DISPLAY_KEY=

